{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumina project metadata",
  "description": "Shape of Lumina/<project>/metadata.json files.",
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "key_assets": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["title", "description", "status", "last_updated", "next_steps", "key_assets"]
}
